prefix_rule(pattern=["apply_patch"], decision="allow")
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["gh"], decision="allow")
prefix_rule(pattern=["git"], decision="allow")
prefix_rule(
    pattern=["git", "push", ["--force", "-f"]],
    decision="prompt",
    justification="Force-pushing can overwrite remote history",
    match=[
        "git push --force origin main",
        "git push -f origin main",
    ],
    not_match=[
        "git push origin main",
        "git push --force-with-lease origin main",
    ],
)
prefix_rule(pattern=["tmux"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["go"], decision = "allow")
prefix_rule(pattern=["fracture"], decision="allow")
prefix_rule(pattern=["vercel"], decision="allow")
prefix_rule(pattern=["codex"], decision="allow")
